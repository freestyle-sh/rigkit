{
  "name": "rigkit-website",
  "compatibility_date": "2026-05-02",
  "main": "./src/worker.ts",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "none",
  },
  "routes": [
    { "pattern": "www.rigkit.dev", "custom_domain": true },
    { "pattern": "rigkit.dev", "custom_domain": true },
    { "pattern": "docs.rigkit.dev", "custom_domain": true },
    { "pattern": "rig.freestyle.sh", "custom_domain": true },
    { "pattern": "rigkit.freestyle.sh", "custom_domain": true },
  ],
  "services": [
    {
      "binding": "DOCS_LATEST",
      "service": "rigkit-docs"
    }
  ],
  "vars": {
    "GITHUB_REPO": "freestyle-sh/rigkit",
    "PUBLIC_BASE_URL": "https://www.rigkit.dev",
    "CACHE_TTL_SECONDS": "30",
  },
  "secrets": {
    "required": ["GITHUB_TOKEN"],
  },
}
